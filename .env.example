# ============================================================
# 服务端专用变量（不会被打包进前端产物）
# ============================================================
# OpenAI 兼容协议的模型服务地址
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型密钥。仅存在于服务端，浏览器无法获取
LLM_API_KEY=sk-your-key-here

# ============================================================
# 前端可读变量（可选）
# 正式提交时请保持注释状态，避免密钥进入构建产物
# ============================================================
# VITE_LLM_BASE_URL=https://api.deepseek.com/v1
# VITE_LLM_MODEL=deepseek-chat
# VITE_LLM_API_KEY=
